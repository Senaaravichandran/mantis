# =============================================================================
# MANTIS Environment Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# --- General ---
MANTIS_ENV=development
MANTIS_DEBUG=true
MANTIS_SECRET_KEY=change-me-in-production

# --- PostgreSQL + TimescaleDB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mantis
POSTGRES_USER=mantis
POSTGRES_PASSWORD=mantis_dev_password
DATABASE_URL=postgresql+asyncpg://mantis:mantis_dev_password@localhost:5432/mantis

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Apache Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SENSOR_TOPIC=mantis.sensors.raw
KAFKA_ALERT_TOPIC=mantis.alerts
KAFKA_AGENT_TOPIC=mantis.agents.tasks

# --- Qdrant (Vector DB) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mantis_documents

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mantis_minio
MINIO_SECRET_KEY=mantis_minio_secret
MINIO_BUCKET=mantis-assets

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:70b-instruct-q4_K_M
OLLAMA_FAST_MODEL=mistral:7b-instruct-v0.3
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- External APIs (Optional) ---
NOAA_API_BASE=https://api.weather.gov
USGS_API_BASE=https://waterservices.usgs.gov/nwis
NBI_DATA_URL=https://www.fhwa.dot.gov/bridge/nbi/ascii2023.cfm

# --- Keycloak (Optional for dev) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mantis
KEYCLOAK_CLIENT_ID=mantis-api
KEYCLOAK_CLIENT_SECRET=change-me
AUTH_ENABLED=false

# Add custom environment variables below
